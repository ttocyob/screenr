// screenr.edc — default basic theme 

fonts {
   font: "fonts/Hack-v3.003/Hack-Bold.ttf" "MONO";
}

#define MONO   "MONO"  
#define FN     "Sans"
#define FNBD   "Sans:style=Bold"

