group {
   name: "screenr/rubberband";

   parts {

      rect {
         name: "bg";
         scale: 1;
         mouse_events: 0;

         description { 
            state: "default" 0.0;
            rel1.relative: 0.0 0.0;
            rel2.relative: 1.0 1.0;
            color: 0 0 0 0; // no cc
         }
      }
   }
}
